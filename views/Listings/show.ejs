
<% layout("/layouts/boilerplate") %>


<div class="show-container">
    <h2 class="show-title"><b><%= listing.title %></b></h2>

    <div class="show-card">
        <img src="<%= listing.image?.url %>" class="show-card-img" alt="listing_image" />

        <div class="show-card-body">
            <p class="show-description"><i>owned by: <%= listing.owner.username %></i></p>
            <p class="show-description"><%= listing.description %></p>
            <p class="show-description"><b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b> / night</p>
            <p class="show-description"><%= listing.location %>, <%= listing.country %></p>

            <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
                <div class="show-buttons">
                    <a href="/listing/<%= listing._id %>/edit" class="edit-btn">Edit this listing</a>
                    <form method="POST" action="/listing/<%= listing._id %>?_method=DELETE">
                        <button type="submit" class="delete-btn">Delete Listing</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>

   <% if (listing.reviews && listing.reviews.length > 0) { %>
    <div class="show-review mb-3 reviews-section">
        <h4>All Reviews</h4>

        <div class="reviews-container">
            <% for (let review of listing.reviews) { %>
                <div class="review-card">
                    <div class="review-top">
                        <div class="review-user">
                            <div class="user-icon"><i class="fa-solid fa-user"></i></div>
                            <div>
                                <h5><%= review.createdBy.username %></h5>
                                <p class="review-date"><%= new Date(review.createdAt).toLocaleDateString("en-IN", { month: "long", year: "numeric" }) %></p>
                            </div>
                        </div>
                    </div>

                    <div class="review-rating">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <span class="star <%= i <= review.rating ? 'filled' : '' %>">★</span>
                        <% } %>
                    </div>

                    <div class="review-footer">
                        <p class="review-comment"><%= review.comment %></p>
                        <form method="POST" action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button type="submit" class="btn-sm delete-review-btn">Delete</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
    <%}%>

    <% if (currUser) { %>
        <div class="show-review mb-3 reviews-section">
            <h4>Leave a Review</h4>

            <form method="POST" action="/listing/<%= listing._id %>/reviews" novalidate class="needs-validation">
                <div class="rating">
                    <label>Rating</label>
                    <div class="stars" id="rating-stars">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <button type="button" class="star-btn" data-rating="<%= i %>">★</button>
                        <% } %>
                    </div>

                    <input type="hidden" name="review[rating]" id="rating-value" />

                    <div class="comment">
                        <label for="comment">Comment</label>
                        <textarea name="review[comment]" id="comment" required></textarea>
                        <div class="valid-feedback">Review looks good!</div>
                        <div class="invalid-feedback">Please add some comments for review.</div>
                    </div>

                    <button type="submit">Submit</button>
                </div>
            </form>
        </div>
    <% } %>

    
<div class="show-review mb-3 reviews-section">
    <h3>Where you'll be</h3>
    <div id="map"></div>
</div>

<script>
    window.mapToken = "<%= process.env.MAP_TOKEN %>";
    window.coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    window.listingLocation = <%- JSON.stringify(listing.location || "") %>;
</script>

<script src="/Js/map.js"></script>
</div>
